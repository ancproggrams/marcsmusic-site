+function positiveNumber(key: keyof NodeJS.ProcessEnv, defaultValue: string, minimum: number, maximum: number): number {
+  const parsed = Number(validateEnv(key, defaultValue));
+  if (!Number.isFinite(parsed) || parsed < minimum || parsed > maximum) {
+    throw new Error(`${key} must be a finite number between ${minimum} and ${maximum}`);
+  }
+  return parsed;
+}
+
+function emailAddress(key: keyof NodeJS.ProcessEnv, defaultValue: string): string {
+  const value = validateEnv(key, defaultValue).trim().toLowerCase();
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/u.test(value)) throw new Error(`${key} must be a valid email address`);
+  return value;
+}
+
+function strictBoolean(key: keyof NodeJS.ProcessEnv, defaultValue: string): boolean {
+  const value = validateEnv<string>(key, defaultValue).trim().toLowerCase();
+  if (value !== 'true' && value !== 'false') throw new Error(`${key} must be either true or false`);
+  return value === 'true';
+}
+
+function nonEmptySingleLine(key: keyof NodeJS.ProcessEnv): string {
+  const value = validateEnv(key).trim();
+  if (!value || /\r|\n/u.test(value)) throw new Error(`${key} must be a non-empty single-line value`);
+  return value;
+}
