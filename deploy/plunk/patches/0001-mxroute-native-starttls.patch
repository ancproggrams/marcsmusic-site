diff --git a/apps/api/src/services/__tests__/SMTPService.test.ts b/apps/api/src/services/__tests__/SMTPService.test.ts
new file mode 100644
index 0000000..24ceb35
--- /dev/null
+++ b/apps/api/src/services/__tests__/SMTPService.test.ts
@@ -0,0 +1,58 @@
+import {beforeAll, describe, expect, it, vi} from 'vitest';
+
+vi.hoisted(() => {
+  Object.assign(process.env, {
+    NODE_ENV: 'test',
+    JWT_SECRET: 'smtp-test-jwt-secret',
+    API_URI: 'http://localhost:8080',
+    DASHBOARD_URI: 'http://localhost:3000',
+    LANDING_URI: 'http://localhost:4000',
+    WIKI_URI: 'http://localhost:1000',
+    REDIS_URL: 'redis://localhost:6379',
+    DATABASE_URL: 'postgresql://localhost/plunk_test',
+    DIRECT_DATABASE_URL: 'postgresql://localhost/plunk_test',
+    SMTP_HOST: 'tuesday.mxrouting.net',
+    SMTP_PORT: '587',
+    SMTP_USER: 'smtp-test-user',
+    SMTP_PASSWORD: 'smtp-test-password',
+    SMTP_SECURE: 'false',
+    SMTP_FROM_ADDRESS: 'noreply@marcsmusic.nl',
+    SMTP_ALLOWED_FROM_ADDRESS: 'noreply@marcsmusic.nl',
+    SMTP_ALLOWED_FROM_DOMAIN: 'marcsmusic.nl',
+  });
+});
+
+import {
+  isSmtpDeliveryUnknown,
+  messageIdFingerprint,
+  sendRawEmail,
+  SmtpDeliveryUncertainError,
+} from '../SMTPService.js';
+
+describe('native MXRoute SMTP transport', () => {
+  beforeAll(() => vi.restoreAllMocks());
+
+  it('classifies timeout-after-DATA as uncertain and never retryable', () => {
+    const error = new SmtpDeliveryUncertainError();
+    expect(isSmtpDeliveryUnknown(error)).toBe(true);
+    expect(error.retryable).toBe(false);
+    expect(error.deliveryUnknown).toBe(true);
+  });
+
+  it('rejects a sender override before opening the SMTP socket', async () => {
+    await expect(
+      sendRawEmail({
+        from: {name: 'MarcsMusic', email: 'spoof@example.com'},
+        to: ['test@example.com'],
+        content: {subject: 'test', html: '<p>test</p>'},
+      }),
+    ).rejects.toMatchObject({code: 'SMTP_FROM_NOT_ALLOWED'});
+  });
+
+  it('produces a stable bounded reconciliation fingerprint', () => {
+    const first = messageIdFingerprint('<message@example.test>');
+    expect(first).toHaveLength(32);
+    expect(messageIdFingerprint('<message@example.test>')).toBe(first);
+    expect(messageIdFingerprint('<other@example.test>')).not.toBe(first);
+  });
+});
