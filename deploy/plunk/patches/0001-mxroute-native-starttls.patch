+
+function assertRecipient(value: Recipient): string {
+  const email = typeof value === 'string' ? value : value.email;
+  assertNoHeaderInjection(email, 'recipient');
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/u.test(email)) {
+    throw new SmtpProviderError('SMTP_RECIPIENT_INVALID', 'The recipient address is invalid');
+  }
+  return email;
+}
+
+function breakLongLines(input: string, maxLineLength: number, isBase64 = false): string {
+  if (isBase64) {
+    const result: string[] = [];
+    for (let i = 0; i < input.length; i += maxLineLength) result.push(input.substring(i, i + maxLineLength));
+    return result.join('\r\n');
+  }
+
+  const lines = input.split(/\r?\n/u);
+  const result: string[] = [];
+  for (let line of lines) {
+    while (line.length > maxLineLength) {
+      let pos = maxLineLength;
+      while (pos > 0 && line[pos] !== ' ') pos -= 1;
+      if (pos === 0) pos = maxLineLength;
+      result.push(line.substring(0, pos));
+      line = line.substring(pos).trim();
+    }
+    result.push(line);
+  }
+  return result.join('\r\n');
