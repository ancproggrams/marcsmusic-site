+    dataStarted = true;
+    expect(await session.data(raw), [250], 'message data');
+  } catch (error) {
+    if (dataStarted && !(error instanceof SmtpProviderError && error.statusCode)) {
+      throw new SmtpDeliveryUncertainError();
+    }
+    if (error instanceof SmtpDeliveryUncertainError) {
+      throw new SmtpProviderError('SMTP_PRE_DATA_TIMEOUT', 'SMTP relay did not respond before DATA', {retryable: true});
+    }
+    throw error;
+  } finally {
+    session?.close();
+  }
+}
+
+/** Send one raw message through MXRoute using explicit STARTTLS. */
+export async function sendRawEmail(params: SendRawEmailParams): Promise<{messageId: string}> {
+  assertFromPolicy(params.from);
+  if (params.to.length === 0 || params.to.length > 100) throw new SmtpProviderError('SMTP_RECIPIENT_COUNT_INVALID', 'Recipient count is outside the supported range');
+  const recipients = params.to.map(assertRecipient);
