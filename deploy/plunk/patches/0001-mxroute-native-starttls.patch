+  assertNoHeaderInjection(value, `header ${name}`);
+  if (value.length > 4096) throw new SmtpProviderError('SMTP_HEADER_TOO_LARGE', `header ${name} is too long`);
+  return value;
+}
+
+function buildRawMessage({from, to, content, reply, headers, attachments}: SendRawEmailParams): {raw: string; id: string} {
+  const messageId = headers && Object.entries(headers).find(([name]) => name.toLowerCase() === 'message-id')?.[1];
+  const id = messageId?.trim() || `<${randomUUID()}@${SMTP_ALLOWED_FROM_DOMAIN}>`;
+  if (!/^<[^<>\s@]+@[^<>\s]+>$/u.test(id)) throw new SmtpProviderError('SMTP_MESSAGE_ID_INVALID', 'Message-ID is invalid');
+
+  const altBoundary = `----=_AltPart_${randomUUID()}`;
+  const mixedBoundary = attachments?.some(a => (a.disposition ?? 'attachment') === 'attachment')
+    ? `----=_MixedPart_${randomUUID()}`
+    : null;
+  const relatedBoundary = attachments?.some(a => a.disposition === 'inline') ? `----=_RelatedPart_${randomUUID()}` : null;
