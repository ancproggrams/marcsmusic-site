+  let rootContentType = `multipart/alternative; boundary="${altBoundary}"`;
+  if (mixedBoundary) rootContentType = `multipart/mixed; boundary="${mixedBoundary}"`;
+  else if (relatedBoundary) rootContentType = `multipart/related; boundary="${relatedBoundary}"`;
+
+  const extraHeaderLines = headers
+    ? Object.entries(headers)
+        .filter(([name]) => !/^message-id$/iu.test(name))
+        .map(([name, value]) => `${normalizeHeaderValue(name, 'name')}: ${normalizeHeaderValue(value, name)}`)
+    : [];
+  const extraHeaders = extraHeaderLines.length > 0 ? `\r\n${extraHeaderLines.join('\r\n')}` : '';
+  const replyTo = reply || from.email;
+  assertNoHeaderInjection(replyTo, 'reply-to');
+  assertNoHeaderInjection(content.subject, 'subject');
+
+  let raw = `From: ${normalizeHeaderValue(from.name, 'from name')} <${from.email}>\r\n`;
+  raw += `To: ${toHeader}\r\n`;
+  raw += `Reply-To: ${replyTo}\r\n`;
+  raw += `Subject: ${normalizeHeaderValue(content.subject, 'subject')}\r\n`;
+  raw += `Date: ${new Date().toUTCString()}\r\n`;
+  raw += `Message-ID: ${id}\r\n`;
+  raw += `MIME-Version: 1.0\r\n`;
+  raw += `Content-Type: ${rootContentType}${extraHeaders}\r\n\r\n`;
+
+  if (mixedBoundary) {
+    raw += `--${mixedBoundary}\r\n`;
+    if (relatedBoundary) raw += `Content-Type: multipart/related; boundary="${relatedBoundary}"\r\n\r\n--${relatedBoundary}\r\n`;
+  } else if (relatedBoundary) {
+    raw += `--${relatedBoundary}\r\n`;
+  }
+  if (mixedBoundary || relatedBoundary) raw += `Content-Type: multipart/alternative; boundary="${altBoundary}"\r\n\r\n`;
+  raw += `--${altBoundary}\r\nContent-Type: text/html; charset=utf-8\r\nContent-Transfer-Encoding: 7bit\r\n\r\n`;
+  raw += `${breakLongLines(content.html, 500)}\r\n--${altBoundary}--\r\n`;
+
+  if (relatedBoundary) {
+    for (const attachment of attachments?.filter(a => a.disposition === 'inline') ?? []) {
+      assertNoHeaderInjection(attachment.filename, 'attachment filename');
+      raw += `\r\n--${relatedBoundary}\r\nContent-Type: ${normalizeHeaderValue(attachment.contentType, 'attachment type')}\r\n`;
+      raw += `Content-Transfer-Encoding: base64\r\nContent-ID: <${attachment.contentId || attachment.filename}>\r\n`;
+      raw += `Content-Disposition: inline; filename="${attachment.filename}"\r\n\r\n`;
+      raw += `${breakLongLines(attachment.content, 76, true)}\r\n`;
+    }
+    raw += `--${relatedBoundary}--\r\n`;
+  }
+  if (mixedBoundary) {
+    for (const attachment of attachments?.filter(a => (a.disposition ?? 'attachment') === 'attachment') ?? []) {
+      assertNoHeaderInjection(attachment.filename, 'attachment filename');
+      raw += `\r\n--${mixedBoundary}\r\nContent-Type: ${normalizeHeaderValue(attachment.contentType, 'attachment type')}\r\n`;
+      raw += `Content-Transfer-Encoding: base64\r\nContent-Disposition: attachment; filename="${attachment.filename}"\r\n\r\n`;
+      raw += `${breakLongLines(attachment.content, 76, true)}\r\n`;
+    }
+    raw += `--${mixedBoundary}--\r\n`;
+  }
+
+  const size = Buffer.byteLength(raw, 'utf8');
+  if (size > MAX_MESSAGE_BYTES) throw new SmtpProviderError('SMTP_MESSAGE_TOO_LARGE', 'Message exceeds SMTP size limit');
+  return {raw, id};
+}
+
+class SmtpSession {
+  private buffer = '';
+  private waiter: {resolve: () => void; reject: (error: Error) => void} | null = null;
+  private closed = false;
+
+  private constructor(private readonly socket: SmtpSocket) {
+    socket.setEncoding('utf8');
+    socket.on('data', data => {
+      this.buffer += String(data);
+      if (this.buffer.length > MAX_RESPONSE_LINE_BYTES * MAX_RESPONSE_LINES) {
+        this.fail(new SmtpProviderError('SMTP_RESPONSE_TOO_LARGE', 'SMTP response exceeded limits'));
+        return;
+      }
+      this.waiter?.resolve();
+      this.waiter = null;
+    });
+    socket.on('error', error => this.fail(error instanceof Error ? error : new Error('SMTP socket error')));
+    socket.on('close', () => {
+      this.closed = true;
+      this.fail(new SmtpDeliveryUncertainError('SMTP connection closed before a final response'));
+    });
+  }
+
+  static async connect(): Promise<SmtpSession> {
+    const socket = await new Promise<SmtpSocket>((resolve, reject) => {
+      const onError = (error: Error) => reject(error);
+      const connected = SMTP_SECURE ? tls.connect({host: SMTP_HOST, port: SMTP_PORT, servername: SMTP_HOST, rejectUnauthorized: true}) : net.connect({host: SMTP_HOST, port: SMTP_PORT});
+      connected.once('error', onError);
+      const event = SMTP_SECURE ? 'secureConnect' : 'connect';
+      connected.once(event, () => {
+        // The protocol methods enforce per-response deadlines. Clear the
+        // connection-level idle timer once the socket is established so it
+        // cannot destroy a healthy session while it is between commands.
+        connected.setTimeout(0);
+        connected.removeListener('error', onError);
+        resolve(connected);
+      });
+      connected.setTimeout(SMTP_TIMEOUT_MS, () => connected.destroy(new SmtpProviderError('SMTP_TIMEOUT', 'SMTP connection timed out')));
+    });
+    return new SmtpSession(socket);
+  }
+
+  private fail(error: Error): void {
+    if (this.waiter) {
+      const waiter = this.waiter;
+      this.waiter = null;
+      waiter.reject(error);
+    }
+  }
+
+  private detach(): void {
+    this.socket.removeAllListeners('data');
+    this.socket.removeAllListeners('error');
+    this.socket.removeAllListeners('close');
+    this.waiter = null;
+  }
+
+  private async line(): Promise<string> {
+    const deadline = Date.now() + SMTP_TIMEOUT_MS;
+    while (true) {
+      const end = this.buffer.indexOf('\n');
+      if (end >= 0) {
+        const line = this.buffer.slice(0, end).replace(/\r$/u, '');
+        this.buffer = this.buffer.slice(end + 1);
+        if (Buffer.byteLength(line, 'utf8') > MAX_RESPONSE_LINE_BYTES) throw new SmtpProviderError('SMTP_RESPONSE_LINE_TOO_LARGE', 'SMTP response line exceeded limits');
+        return line;
+      }
+      if (this.closed) throw new SmtpDeliveryUncertainError();
+      const remaining = Math.max(1, deadline - Date.now());
+      await new Promise<void>((resolve, reject) => {
+        this.waiter = {resolve, reject};
+        const timeout = setTimeout(() => {
+          this.waiter = null;
+          reject(new SmtpDeliveryUncertainError('SMTP response timed out'));
+        }, remaining);
+        const previous = this.waiter;
+        this.waiter = {
+          resolve: () => {
+            clearTimeout(timeout);
+            previous.resolve();
+          },
+          reject: error => {
+            clearTimeout(timeout);
+            previous.reject(error);
+          },
+        };
+      });
+    }
+  }
+
+  async reply(): Promise<SmtpReply> {
+    const first = await this.line();
+    const match = /^(\d{3})([- ])(.*)$/u.exec(first);
+    if (!match) throw new SmtpProviderError('SMTP_PROTOCOL_ERROR', 'Malformed SMTP response');
+    const code = Number(match[1]);
+    const lines = [match[3] ?? ''];
+    while (match[2] === '-') {
+      const line = await this.line();
+      const next = /^(\d{3})([- ])(.*)$/u.exec(line);
+      if (!next || Number(next[1]) !== code) throw new SmtpProviderError('SMTP_PROTOCOL_ERROR', 'Malformed multiline SMTP response');
+      lines.push(next[3] ?? '');
+      if (next[2] === ' ') break;
+    }
+    return {code, lines};
+  }
+
+  async command(command: string): Promise<SmtpReply> {
+    assertNoHeaderInjection(command, 'SMTP command');
+    this.socket.write(`${command}\r\n`);
+    return this.reply();
+  }
+
+  async data(raw: string): Promise<SmtpReply> {
+    const normalized = raw.replace(/\r?\n/gu, '\r\n');
+    const stuffed = normalized
+      .split('\r\n')
+      .map(line => (line.startsWith('.') ? `.${line}` : line))
+      .join('\r\n');
+    this.socket.write(`${stuffed}\r\n.\r\n`);
+    return this.reply();
+  }
+
+  async startTls(): Promise<SmtpSession> {
+    // The pre-TLS session must release its data/error listeners. Keeping them
+    // attached would race the new TLS session and consume encrypted bytes.
+    this.detach();
+    const secure = await new Promise<tls.TLSSocket>((resolve, reject) => {
+      const upgraded = tls.connect({socket: this.socket, servername: SMTP_HOST, rejectUnauthorized: true});
+      upgraded.once('error', reject);
+      upgraded.once('secureConnect', () => {
+        upgraded.setTimeout(0);
+        resolve(upgraded);
+      });
+      upgraded.setTimeout(SMTP_TIMEOUT_MS, () => upgraded.destroy(new SmtpDeliveryUncertainError('SMTP STARTTLS timed out')));
+    });
+    return new SmtpSession(secure);
+  }
+
+  close(): void {
+    this.socket.end();
+  }
+}
+
+function expect(reply: SmtpReply, allowed: number[], operation: string): void {
+  if (allowed.includes(reply.code)) return;
+  const retryable = reply.code >= 400 && reply.code < 500;
+  throw new SmtpProviderError(`SMTP_${reply.code}`, `${operation} rejected by SMTP relay`, {
+    statusCode: reply.code,
+    retryable,
+  });
+}
+
+function capability(reply: SmtpReply, name: string): string | undefined {
+  const line = reply.lines.find(value => value.toUpperCase().startsWith(name.toUpperCase()));
+  return line?.slice(name.length).trim();
+}
+
+async function authenticate(session: SmtpSession, ehlo: SmtpReply): Promise<void> {
+  const auth = capability(ehlo, 'AUTH');
+  const mechanisms = auth?.split(/\s+/u).map(value => value.toUpperCase()) ?? [];
+  if (mechanisms.includes('PLAIN')) {
+    const payload = Buffer.from(`\0${SMTP_USER}\0${SMTP_PASSWORD}`, 'utf8').toString('base64');
+    expect(await session.command(`AUTH PLAIN ${payload}`), [235], 'SMTP authentication');
+    return;
+  }
+  if (!mechanisms.includes('LOGIN')) throw new SmtpProviderError('SMTP_AUTH_UNSUPPORTED', 'SMTP relay did not advertise AUTH PLAIN or LOGIN');
+  expect(await session.command('AUTH LOGIN'), [334], 'SMTP authentication');
+  expect(await session.command(Buffer.from(SMTP_USER, 'utf8').toString('base64')), [334], 'SMTP username');
+  expect(await session.command(Buffer.from(SMTP_PASSWORD, 'utf8').toString('base64')), [235], 'SMTP password');
+}
+
+async function sendViaSmtp({from, to, raw}: {from: string; to: string[]; raw: string}): Promise<void> {
+  if (NODE_ENV === 'test' && process.env.SMTP_TEST_TRANSPORT !== 'network') {
+    smtpTestTransport.calls.push({from, to: [...to], raw});
+    return;
+  }
+  let session: SmtpSession | null = null;
+  let dataStarted = false;
+  try {
+    session = await SmtpSession.connect();
+    expect(await session.reply(), [220], 'SMTP greeting');
+    let ehlo = await session.command(`EHLO marcsmusic.nl`);
+    expect(ehlo, [250], 'EHLO');
+    if (!SMTP_SECURE) {
+      const startTls = capability(ehlo, 'STARTTLS');
+      if (!startTls) throw new SmtpProviderError('SMTP_STARTTLS_REQUIRED', 'SMTP relay did not advertise STARTTLS');
+      expect(await session.command('STARTTLS'), [220], 'STARTTLS');
+      session = await session.startTls();
+      ehlo = await session.command(`EHLO marcsmusic.nl`);
+      expect(ehlo, [250], 'EHLO after STARTTLS');
+    }
+    await authenticate(session, ehlo);
+    expect(await session.command(`MAIL FROM:<${from}>`), [250], 'MAIL FROM');
+    for (const recipient of to) expect(await session.command(`RCPT TO:<${recipient}>`), [250, 251], 'RCPT TO');
