+    .map(recipient => {
+      if (typeof recipient === 'string') return recipient;
+      const name = recipient.name ? normalizeHeaderValue(recipient.name, 'recipient name') : '';
+      return name ? `${name} <${recipient.email}>` : recipient.email;
+    })
+    .join(', ');
