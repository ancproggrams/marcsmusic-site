+export async function getIdentities(domains: string[]): Promise<{domain: string; status: string}[]> {
+  return Promise.all(
+    domains.map(async domain => ({domain, status: (await getDomainVerificationAttributes(domain)).status})),
+  );
+}
+
+export async function verifyDomain(domain: string): Promise<string[]> {
+  if (domain.toLowerCase() !== SMTP_ALLOWED_FROM_DOMAIN.toLowerCase()) {
+    throw new SmtpProviderError('SMTP_DOMAIN_NOT_ALLOWED', 'Only the configured MXRoute sender domain is allowed');
+  }
+  const mx = await resolveMx(domain);
+  if (!mx) throw new SmtpProviderError('SMTP_DOMAIN_MX_MISSING', 'Configured sender domain has no public MX record');
+  return [`mx:${mx}`];
+}
+
+export async function getDomainVerificationAttributes(domain: string): Promise<{domain: string; tokens: string[]; status: string}> {
+  if (domain.toLowerCase() !== SMTP_ALLOWED_FROM_DOMAIN.toLowerCase()) return {domain, tokens: [], status: 'NotStarted'};
+  const mx = await resolveMx(domain);
+  return {domain, tokens: mx ? [`mx:${mx}`] : [], status: mx ? 'Success' : 'Failed'};
+}
+
+export async function disableFeedbackForwarding(_domain: string): Promise<void> {
+  // MXRoute feedback handling is outside Plunk's SES contract. Keep this
+  // function as a no-op so domain verification never calls AWS at runtime.
+}
+
+export async function deleteIdentity(_domain: string): Promise<void> {
+  // Sender authorization is configuration-owned; no provider identity exists
+  // to delete from Plunk.
+}
+
+/** Return the explicitly bounded SMTP rate; MXRoute has no quota API here. */
+export async function getSendingQuota(): Promise<{maxSendRate: number; max24HourSend: number; sentLast24Hours: number}> {
+  return {maxSendRate: EMAIL_RATE_LIMIT_PER_SECOND, max24HourSend: Number.MAX_SAFE_INTEGER, sentLast24Hours: 0};
+}
+
+async function resolveMx(domain: string): Promise<string | null> {
+  try {
+    const records = await dns.resolveMx(domain);
+    const sorted = records.sort((left, right) => left.priority - right.priority);
+    return sorted[0]?.exchange ?? null;
+  } catch (error) {
+    signale.warn(`[SMTP-DOMAIN] MX lookup failed for configured sender domain: ${error instanceof Error ? error.name : 'unknown'}`);
+    return null;
+  }
+}
+
+// Keep an exported helper for deterministic message-id reconciliation tooling.
+export function messageIdFingerprint(messageId: string): string {
+  return createHash('sha256').update(messageId).digest('hex').slice(0, 32);
+}
