DATABASE_URL="postgresql://postgres:postgres@localhost:5432/soundcloud_growth_os?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required for every dashboard/page/API route except exact /api/health,
# Next static assets, and the independently protected legacy outreach route.
# Generate a unique random password (for example: openssl rand -base64 48).
GROWTH_OS_ADMIN_USERNAME=""
GROWTH_OS_ADMIN_PASSWORD=""

# Create these in the official SoundCloud developer app dashboard.
SOUNDCLOUD_CLIENT_ID=""
SOUNDCLOUD_CLIENT_SECRET=""
SOUNDCLOUD_REDIRECT_URI="http://localhost:3000/api/auth/soundcloud/callback"

# Required before connecting or syncing SoundCloud. Values are AES-256 keys
# encoded as canonical base64. The active kid must exist in the bounded JSON
# keyring; historical entries are decrypt-only. Never put a real key here.
SOUNDCLOUD_TOKEN_ACTIVE_KID=""
SOUNDCLOUD_TOKEN_KEYS_JSON="{}"

# Bounded reliability controls. Values outside the documented code-enforced
# ranges fail readiness instead of silently weakening production safeguards.
SOUNDCLOUD_REFRESH_LOCK_WAIT_MS="1500"
SOUNDCLOUD_API_DEADLINE_MS="15000"
SOUNDCLOUD_API_MAX_RESPONSE_BYTES="1048576"
SOUNDCLOUD_HEALTH_DB_TIMEOUT_MS="2000"

# One-off migration job controls. Never enable the legacy migration gate on the
# long-running web service. New writes are encrypted regardless of these flags.
SOUNDCLOUD_TOKEN_ALLOW_LEGACY_PLAINTEXT_MIGRATION="false"
SOUNDCLOUD_TOKEN_REENCRYPT_APPLY="false"
SOUNDCLOUD_TOKEN_REENCRYPT_MAX_ROWS="100"
SOUNDCLOUD_TOKEN_REENCRYPT_AFTER_ID=""
SOUNDCLOUD_TOKEN_VALIDATE_CONSTRAINT="false"

# Mailgun outreach email. Keep MXRoute on marcsmusic.nl for normal mailboxes;
# send outreach from the verified Mailgun subdomain.
MAILGUN_API_KEY=""
MAILGUN_DOMAIN="mg.marcsmusic.nl"
MAILGUN_BASE_URL="https://api.eu.mailgun.net"
OUTREACH_FROM_EMAIL="outreach@mg.marcsmusic.nl"
OUTREACH_FROM_NAME="Marc Rene"
OUTREACH_REPLY_TO="marc@marcsmusic.nl"
OUTREACH_MAIL_TOKEN=""
# Deprecated direct sender. Exact true works only in a non-production,
# non-Railway development/test runtime. Any production or Railway marker
# forces both the route and Mailgun provider gates closed.
LEGACY_OUTREACH_SEND_ENABLED="false"
OUTREACH_MAX_EMAILS_PER_HOUR="20"
OUTREACH_MP3_ROOT="outreach-mp3"

# Optional comma-separated allowlist, for example: "example.com,partner.org".
# Leave empty only when manual review and account-level abuse controls are in place.
OUTREACH_ALLOWED_RECIPIENT_DOMAINS=""
