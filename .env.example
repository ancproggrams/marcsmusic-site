APP_BASE_URL=https://www.marcsmusic.nl
PORT=3000
# Forwarded client-IP headers are ignored unless the direct peer matches one of
# these explicit IP/CIDR entries. Configure only the actual Railway/edge proxy
# network; leave empty for direct or unknown proxy topologies.
TRUSTED_PROXY_CIDRS=
# Used only on Railway while TRUSTED_PROXY_CIDRS is empty. Requests then share
# the edge peer bucket; the independent global cap always remains active.
RATE_LIMIT_RAILWAY_FALLBACK_MAX_REQUESTS=300
RATE_LIMIT_GLOBAL_MAX_REQUESTS=1000

# Public EPK manifest. The site still starts when the file is absent and then
# reports capabilities.epk=false. Only add audited external HTTPS origins.
EPK_MANIFEST_ROOT=/data/epk
EPK_MANIFEST_PATH=/data/epk/public-epk-manifest.json
EPK_ALLOWED_HTTPS_ORIGINS=
EPK_PUBLIC_ASSET_PREFIXES=/assets/epk/

# Public booking rules
BOOKING_TIMEZONE=Europe/Amsterdam
BOOKING_WORKDAY_START=10:00
BOOKING_WORKDAY_END=22:00
BOOKING_SLOT_STEP_MINUTES=30
BOOKING_MAX_CONSECUTIVE_SLOTS=4
BOOKING_BUFFER_MINUTES=30
BOOKING_MIN_LEAD_HOURS=24
BOOKING_PENDING_HOLD_MINUTES=20

# Prices are in cents
BOOKING_PRICE_STUDIO_CENTS=7500
BOOKING_PRICE_DJ_CENTS=20000
BOOKING_PRICE_OTHER_CENTS=9900
BOOKING_DURATION_STUDIO_MINUTES=60
BOOKING_DURATION_DJ_MINUTES=60
BOOKING_DURATION_OTHER_MINUTES=60
BOOKING_TRAVEL_RATE_CENTS_PER_HOUR=7500
BOOKING_MAX_TRAVEL_HOURS=24

# EspoCRM
ESPOCRM_BASE_URL=https://crm.marcsmusic.nl
ESPOCRM_API_KEY=
ESPOCRM_API_SECRET=
CRM_HTTP_TIMEOUT_MS=5000
ESPOCRM_USE_CUSTOM_FIELDS=false
CRM_NEWSLETTER_LIST=MarcsMusic Newsletter
NEWSLETTER_FROM_EMAIL=noreply@marcsmusic.nl
NEWSLETTER_FROM_NAME=MarcsMusic
CRM_BOOKING_ENTITY=DJBooking
CRM_SOURCE_WEBSITE=marcsmusic.nl

# Film director outreach search cron
FILM_DIRECTOR_LEADS_CSV=data/film-director-leads-2026-07-06.csv
FILM_DIRECTOR_DISCOVERY_ENABLED=true
FILM_DIRECTOR_SOURCE_CONFIG=data/film-director-discovery-sources.json
FILM_DIRECTOR_COUNTRY_SHARDS=data/film-director-country-shards.json
FILM_DIRECTOR_MAX_SOURCE_ITEMS=12
FILM_DIRECTOR_SHARDS_PER_RUN=8
FILM_DIRECTOR_SEARCH_TEMPLATES_PER_SHARD=2
FILM_DIRECTOR_SEARCH_ITEMS_PER_QUERY=2
FILM_DIRECTOR_SEARCH_MAX_PAGE_FETCHES=32
FILM_DIRECTOR_MIN_CONFIDENCE=6
FILM_DIRECTOR_FETCH_TIMEOUT_MS=15000
FILM_DIRECTOR_FETCH_MAX_BYTES=2097152
FILM_DIRECTOR_FETCH_DELAY_MS=250
FILM_DIRECTOR_SEARCH_OUTPUT_CSV=/tmp/marcsmusic-film-director/combined-leads.csv
FILM_DIRECTOR_RETAIN_DISCOVERY_OUTPUT=false
SEARCH_ACTION_DRY_RUN=false
SEARCH_ACTION_LOCK_TTL_MS=600000

# Self-hosted calendar, e.g. Radicale
CALDAV_BASE_URL=https://calendar.marcsmusic.nl
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_CALENDAR_PATH=/marcsmusic/bookings/
CALDAV_HTTP_TIMEOUT_MS=5000
CALDAV_RESPONSE_MAX_BYTES=1048576
CALENDAR_FULFILLMENT_LEASE_MS=30000

# Mollie
MOLLIE_API_KEY=
MOLLIE_PROFILE_ID=
# Optional when the API key starts with test_ or live_; otherwise required.
MOLLIE_MODE=
MOLLIE_API_BASE_URL=https://api.mollie.com
MOLLIE_HTTP_TIMEOUT_MS=5000

# Admin page and privacy
# Required for /api/admin/*; 32-512 bytes, no whitespace. Generate and store it
# in Railway secret variables; never copy this placeholder to production.
ADMIN_TOKEN=replace-with-at-least-32-random-bytes
BOOKING_ADMIN_EMAIL=
PRIVACY_HASH_SALT=change-this-random-salt

# Railway persistent volume mounted at /data.
BOOKING_DB_PATH=/data/bookings.json
