NODE_ENV=development
PORT=8080
# Per-replica cap for every HTTP request except /livez. Overflow receives 429
# with Retry-After; liveness remains available for process supervision.
HTTP_MAX_IN_FLIGHT_REQUESTS=64
LOG_LEVEL=info
OUTREACH_PROCESS_MODE=all

# Dedicated PostgreSQL instance for queue/idempotency state. Do not reuse the
# EspoCRM database.
DATABASE_URL=postgresql://user:password@localhost:5432/marcsmusic_outreach
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Every database wait is bounded. Keep query timeout above statement timeout;
# advisory locks use try-lock polling and fail retryably instead of blocking.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=20000
DATABASE_ADVISORY_LOCK_TIMEOUT_MS=5000

# EspoCRM is the authoritative business system.
ESPOCRM_BASE_URL=https://crm.example.com
ESPOCRM_API_KEY=
ESPOCRM_TIMEOUT_MS=10000
ESPOCRM_MAX_PAGE_SIZE=200

# EspoCRM webhook verification. JSON map of webhook ID to secret key.
ESPOCRM_WEBHOOK_SECRETS_JSON={}

# Outbound delivery uses self-hosted Plunk. Keep this secret and the webhook
# secret only in Railway variables. Mailgun below is retained for staged
# inbound/reconciliation compatibility only.
PROVIDER_CAPABILITY_CACHE_TTL_MS=30000
EMAIL_PROVIDER=plunk
PLUNK_BASE_URL=https://mail.marcsmusic.nl
PLUNK_SECRET_KEY=
PLUNK_FROM=MarcsMusic <marc@marcsmusic.nl>
PLUNK_REPLY_TO=marc@marcsmusic.nl
PLUNK_WEBHOOK_SECRET=
PLUNK_TIMEOUT_MS=15000
PLUNK_MAX_RESPONSE_BYTES=65536

# Legacy Mailgun EU is retained only for inbound/reconciliation compatibility.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM=MarcsMusic <music@example.com>
MAILGUN_REPLY_TO=music@example.com
MAILGUN_WEBHOOK_SIGNING_KEY=
# Non-mutating GET /v4/domains/{domain}; never sends or validates a recipient.
MAILGUN_HEALTH_TIMEOUT_MS=3000
MAILGUN_HEALTH_MAX_RESPONSE_BYTES=16384
# Keep `unknown` until an operator has archived live inbound-route evidence.
# `configured` requires a non-secret, opaque evidence reference.
MAILGUN_INBOUND_ROUTE_EVIDENCE=unknown
MAILGUN_INBOUND_ROUTE_EVIDENCE_REFERENCE=

# Safe by default: both switches must explicitly permit sending.
OUTREACH_KILL_SWITCH=true
OUTREACH_SEND_ENABLED=false
OUTREACH_PUBLIC_BASE_URL=https://outreach.example.com
OUTREACH_DAILY_SEND_LIMIT=40
OUTREACH_DOMAIN_DAILY_LIMIT=2
OUTREACH_AUTOMATIC_RESPONSE_DAILY_LIMIT=20
OUTREACH_AUTOMATIC_RESPONSE_CONTACT_LIMIT=2
OUTREACH_MATCH_THRESHOLD=80
OUTREACH_WAITLIST_THRESHOLD=65
OUTREACH_COOLDOWN_DAYS=21
OUTREACH_OUTLET_COOLDOWN_DAYS=14
OUTREACH_MAX_FOLLOW_UPS=2
OUTREACH_RECONCILE_INTERVAL_MS=21600000
OUTREACH_RECONCILE_OVERLAP_MINUTES=5
OUTREACH_RECONCILE_LEASE_SECONDS=120
OUTREACH_RECONCILE_MAX_RECORDS_PER_ENTITY=10000000
# Optional missed-webhook recovery. Logs API is the supported default; the
# deprecated Events API must be selected explicitly. Five-minute overlap is a
# fixed replay-safety contract. Stored replies additionally require configured
# inbound-route evidence; otherwise Espo incoming Email polling remains active.
OUTREACH_OUTCOME_RECONCILE_ENABLED=false
OUTREACH_OUTCOME_RECONCILE_MAILGUN_ENABLED=true
OUTREACH_OUTCOME_RECONCILE_ESPO_EMAIL_ENABLED=true
OUTREACH_OUTCOME_RECONCILE_DUE_MATCHES_ENABLED=true
OUTREACH_OUTCOME_RECONCILE_MAILGUN_STORED_REPLIES_ENABLED=false
OUTREACH_OUTCOME_RECONCILE_MAILGUN_MODE=logs
OUTREACH_OUTCOME_RECONCILE_INTERVAL_MS=900000
OUTREACH_OUTCOME_RECONCILE_OVERLAP_SECONDS=300
OUTREACH_OUTCOME_RECONCILE_SETTLE_DELAY_SECONDS=300
OUTREACH_OUTCOME_RECONCILE_INITIAL_LOOKBACK_HOURS=24
OUTREACH_OUTCOME_RECONCILE_LEASE_SECONDS=120
OUTREACH_OUTCOME_RECONCILE_PAGE_SIZE=100
OUTREACH_OUTCOME_RECONCILE_MAX_PAGES=25
OUTREACH_OUTCOME_RECONCILE_MAX_BACKLOG=10000
OUTREACH_OUTCOME_RECONCILE_MAX_RESPONSE_BYTES=2097152
OUTREACH_OUTCOME_RECONCILE_STORAGE_MAX_RESPONSE_BYTES=1048576
OUTREACH_WORK_POLL_MS=2000
OUTREACH_SEND_POLL_MS=5000
# Priority-isolated claim lanes. Their sum plus two ingress/control-plane
# connections (three when durable observability is enabled) must not exceed
# DATABASE_POOL_MAX.
OUTREACH_SAFETY_EVENT_CONCURRENCY=2
OUTREACH_PROJECTION_CONCURRENCY=1
OUTREACH_MATCH_CONCURRENCY=1
OUTREACH_MAINTENANCE_CONCURRENCY=1
OUTREACH_SEND_CONCURRENCY=1
# Railway grants 30 seconds; the process self-terminates no later than 25s.
OUTREACH_SHUTDOWN_TIMEOUT_MS=25000
OUTREACH_HEALTH_INTERVAL_MS=3600000
OUTREACH_MIN_HEALTH_SAMPLE=20
OUTREACH_MAX_BOUNCE_RATE=0.05
OUTREACH_MAX_FAILURE_RATE=0.20

# Default-disabled durable operational observability. Enabling requires the
# exact versioned policy JSON plus an independently approved runtime reference.
# See docs/durable-observability.md; do not invent production thresholds here.
OUTREACH_OBSERVABILITY_POLICY_JSON=
OUTREACH_OBSERVABILITY_RUNTIME_APPROVAL_REFERENCE=
OUTREACH_OBSERVABILITY_PRUNE_INTERVAL_MS=300000
OUTREACH_OBSERVABILITY_RETRY_INTERVAL_MS=2000
OUTREACH_OBSERVABILITY_PRUNE_MAX_BATCHES=10
OUTREACH_OBSERVABILITY_CAPACITY_HEADROOM_SAMPLES=10
OUTREACH_ALERT_PROJECTOR_INTERVAL_MS=5000
OUTREACH_ALERT_PROJECTOR_BATCH_SIZE=100
OUTREACH_ALERT_OUTBOX_MAX_BACKLOG=10000
# Alert routing and dashboards remain external/unconfigured. No generic URL or
# token is accepted by this service.

# 32 random bytes, base64 encoded. Rotate using key-versioned migration.
OUTREACH_DATA_ENCRYPTION_KEY=
OUTREACH_DATA_KEY_VERSION=v1
# Historical decrypt-only keyring as {"old-version":"base64-32-byte-key"}.
# Never include the active version; remove an old key only after bounded
# re-encryption, verification and backup/restore evidence are complete.
OUTREACH_DATA_DECRYPTION_KEYS_JSON={}
OUTREACH_HASH_KEY=
# Keep this identity namespace stable after attestation; this release has no
# hash namespace migration/dual-read path.
OUTREACH_HASH_KEY_EPOCH=v1
# One-time migration-018 bootstrap only when an existing database already has
# keyed identities. Remove both values immediately after the first attestation.
OUTREACH_HASH_KEY_BOOTSTRAP_REFERENCE=
OUTREACH_HASH_KEY_BOOTSTRAP_CONFIRM=
# Strict v2 keyring. New tokens use only `active`; `verifyOnly` accepts bounded
# historical kids during rotation. Replace the empty key before startup.
OUTREACH_UNSUBSCRIBE_KEYRING_JSON={"schemaVersion":2,"active":{"kid":"replace-me","key":""},"verifyOnly":[]}
# Default off. A legacy v1 key is accepted only when both an independent key and
# an exact ISO cutoff (no more than two years ahead) are configured temporarily.
OUTREACH_UNSUBSCRIBE_LEGACY_V1_VERIFY_KEY= # gitleaks:allow - intentionally empty example placeholder
OUTREACH_UNSUBSCRIBE_LEGACY_V1_VERIFY_UNTIL=

# Optional structured-copy HTTP provider. The template fallback is used when
# disabled, unavailable, or below the confidence threshold.
COPY_PROVIDER_ENABLED=false
COPY_PROVIDER_URL=
COPY_PROVIDER_TOKEN=
COPY_PROVIDER_MODEL=
COPY_PROVIDER_TIMEOUT_MS=15000
COPY_MIN_CONFIDENCE=0.85

# Mandatory pre-artifact reachability gate for the selected EPK/private-stream
# URL. HTTPS/443 only; every DNS answer and redirect hop is validated and the
# connection is pinned to the validated public address. Response bodies are not
# consumed; response headers are bounded by the configured byte limit.
COPY_LINK_CHECK_TIMEOUT_MS=10000
COPY_LINK_CHECK_MAX_REDIRECTS=3
COPY_LINK_CHECK_MAX_HEADER_BYTES=16384

# Default-off EPK activation evidence verifier. This one-shot job reads only
# Draft/Paused MusicRelease records and OCC-writes only the four EPK proof
# fields; it never changes a release to Active. Every EPK, redirect and asset
# origin must appear as an exact HTTPS origin without a trailing slash.
EPK_VERIFIER_ENABLED=false
EPK_VERIFIER_APPROVED_HTTPS_ORIGINS=
EPK_VERIFIER_TOTAL_TIMEOUT_MS=20000
EPK_VERIFIER_MAX_REDIRECTS=2
EPK_VERIFIER_MAX_HEADER_BYTES=16384
EPK_VERIFIER_MAX_JSON_BODY_BYTES=262144
EPK_VERIFIER_MAX_HTML_BODY_BYTES=524288
EPK_VERIFIER_MAX_ASSET_BYTES=1073741824
EPK_VERIFIER_MAX_BATCH_SIZE=10

# Signed, replay-protected discovery/release artifact ingestion. Keep disabled
# until every configured producer has an independent active key id/key pair.
SOURCE_INGESTION_ENABLED=false
SOURCE_INGESTION_KEYRINGS_JSON={"schemaVersion":2,"sources":{}}
SOURCE_INGESTION_MAX_SKEW_SECONDS=300
SOURCE_INGESTION_MAX_ARTIFACT_AGE_SECONDS=86400
SOURCE_INGESTION_MAX_EVIDENCE_AGE_SECONDS=7776000
SOURCE_INGESTION_PROCESSING_LEASE_SECONDS=900

# Independent email validation. When disabled, newly ingested contacts remain
# Needs Validation / Unknown and can never pass the matching eligibility gate.
EMAIL_VALIDATION_PROVIDER_ENABLED=false
EMAIL_VALIDATION_PROVIDER_TYPE=mailgun
# mailgun reuses the official MAILGUN_BASE_URL, MAILGUN_API_KEY and
# MAILGUN_DOMAIN values above; it calls GET /v4/address/validate and never
# sends a message. Use http or smtp only for explicitly approved alternatives.
EMAIL_VALIDATION_PROVIDER_URL=
EMAIL_VALIDATION_PROVIDER_TOKEN=
EMAIL_VALIDATION_PROVIDER_TIMEOUT_MS=10000
# Optional dedicated GET endpoint. It must be non-mutating and return
# application/json with {"status":"ok"}; blank means live health is unknown.
EMAIL_VALIDATION_PROVIDER_HEALTH_URL=
EMAIL_VALIDATION_PROVIDER_HEALTH_TIMEOUT_MS=3000
EMAIL_VALIDATION_PROVIDER_HEALTH_MAX_RESPONSE_BYTES=16384
# Optional direct SMTP/MX envelope probe (`MAIL FROM`, `RCPT TO`, `RSET`,
# `QUIT`; never `DATA`). It rejects private/reserved MX destinations, is
# strictly time/host bounded, and remains disabled unless provider type is smtp.
EMAIL_VALIDATION_SMTP_HELO_DOMAIN=outreach.example.com
EMAIL_VALIDATION_SMTP_CONNECT_TIMEOUT_MS=3000
EMAIL_VALIDATION_SMTP_COMMAND_TIMEOUT_MS=3000
EMAIL_VALIDATION_SMTP_TOTAL_TIMEOUT_MS=12000
EMAIL_VALIDATION_SMTP_MAX_MX_HOSTS=2
EMAIL_VALIDATION_CACHE_TTL_DAYS=30

# Privacy governance is disabled and fail-closed while this value is empty.
# Supply only a versioned JSON policy approved by the privacy/records owner.
# An enabled policy must contain exactly all nine compiled data classes. Every
# class must explicitly declare retentionDays,
# minimumRetentionDays, maximumRetentionDays, batchSize and
# maximumRecordsPerPlan. The application deliberately supplies no duration.
OUTREACH_RETENTION_POLICY_JSON=
# Required only for an explicitly approved, digest-bound retention execution.
OUTREACH_PRIVACY_EXECUTION_CONFIRM=
# Required only for online privacy schema preparation: concurrent indexes,
# bounded keyset backfill, FK validation, then metadata-only UUID defaults and
# validated NOT NULL finalization. Migration 008 itself never performs a
# volatile-default rewrite of existing large tables.
OUTREACH_PRIVACY_INDEX_CONFIRM=

# Protect the Prometheus endpoint. Health endpoints remain public.
METRICS_TOKEN=
