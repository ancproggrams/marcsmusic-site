{
  "name": "marcsmusic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MarcsMusic integration tooling.",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "check": "find src scripts tests -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test",
    "start": "node scripts/music-api-server.mjs",
    "mailgun:send-test": "node scripts/send-test-email.mjs",
    "music-api:start": "node scripts/music-api-server.mjs"
  },
  "dependencies": {
    "graphql": "^16.14.2"
  }
}
