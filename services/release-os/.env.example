# Mailgun private API key or domain sending key.
MAILGUN_API_KEY=

# Sending domain, for example mg.example.com.
MAILGUN_DOMAIN=

# Mailgun region for the sending domain: us or eu.
MAILGUN_REGION=us

# Optional override. Defaults to the official US/EU Mailgun API hosts.
# MAILGUN_BASE_URL=https://api.mailgun.net

# Default sender used by scripts and callers that do not provide `from`.
MAILGUN_FROM="MarcsMusic <postmaster@mg.example.com>"

# Smoke-test recipient for `npm run mailgun:send-test`.
MAILGUN_TEST_TO=

# Deprecated direct release-os sender. This can only be enabled in an explicit
# non-production/non-Railway runtime; production markers always force it off.
LEGACY_OUTREACH_SEND_ENABLED=false

# Durable, signed release facts for the central outreach worker. The producer
# stages its outbox in the same atomic JSON-store commit as a new release. Keep
# disabled until staging has a unique v2 active key id and 32+ character key.
OUTREACH_SOURCE_PUBLISH_ENABLED=false
OUTREACH_SOURCE_INGESTION_BASE_URL=https://outreach.example.com
OUTREACH_SOURCE_SIGNING_KEY_ID=
OUTREACH_SOURCE_SIGNING_KEY=
OUTREACH_SOURCE_PUBLISH_INTERVAL_MS=900000
OUTREACH_SOURCE_TIMEOUT_MS=10000
OUTREACH_SOURCE_MAX_ATTEMPTS=4
OUTREACH_SOURCE_MAX_REISSUES=3
OUTREACH_SOURCE_MAX_OPERATOR_RECOVERIES=3
# Refresh safely before the consumer's hard 24-hour artifact limit.
OUTREACH_SOURCE_ENVELOPE_MAX_AGE_MS=82800000
# Required only for the explicit `npm run outreach-source:recover` command.
OUTREACH_SOURCE_RECOVERY_OPERATOR=
OUTREACH_SOURCE_RECOVERY_REASON=

# Optional request timeout in milliseconds.
MAILGUN_TIMEOUT_MS=10000
MAILGUN_MAX_RESPONSE_BYTES=65536

# Local MarcsMusic release planning API.
MUSIC_API_HOST=127.0.0.1
MUSIC_API_PORT=8787
# Required for every /music/* and /graphql route. Username is 1-256 bytes;
# password is 32-256 bytes. Empty/weak credentials keep those routes unavailable
# (503); incorrect credentials return 401.
MUSIC_API_ADMIN_USERNAME=
MUSIC_API_ADMIN_PASSWORD=
MUSIC_STORE_PATH=
MUSIC_UPLOAD_DIR=./data/uploads
MUSIC_MAX_AUDIO_BYTES=83886080
MUSIC_MAX_ARTWORK_BYTES=15728640
# Real publication reads local audio only inside MUSIC_UPLOAD_DIR. HTTPS source
# fetching is a non-production convenience and is always disabled on Railway or
# NODE_ENV=production, even when an origin appears below.
MUSIC_MEDIA_SOURCE_HTTPS_ORIGINS=
MUSIC_MEDIA_SOURCE_TIMEOUT_MS=10000
MUSIC_REMOTE_MEDIA_MAX_BYTES=26214400
MUSIC_PROVIDER_TIMEOUT_MS=15000
MUSIC_PROVIDER_MAX_RESPONSE_BYTES=262144
# Durable publication claims. Expired leases never auto-retry provider I/O;
# they enter reconciliation_required for an explicit operator decision.
MUSIC_PUBLICATION_LEASE_MS=60000
MUSIC_PUBLICATION_MAX_OUTBOX_RECORDS=50000
MUSIC_PUBLICATION_MAX_ATTEMPT_RECORDS=5000
MUSIC_FILE_LOCK_TIMEOUT_MS=10000
MUSIC_FILE_LOCK_LEASE_MS=15000
MUSIC_MAX_CONCURRENT_UPLOADS=1
MUSIC_ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/x-wav
MUSIC_ALLOWED_ARTWORK_TYPES=image/jpeg,image/png,image/webp

# Required to issue private player/download URLs. Use a dedicated random secret
# of 32-256 bytes and rotate it deliberately; rotation invalidates open URLs.
MUSIC_ASSET_SIGNING_KEY=
MUSIC_ASSET_URL_TTL_SECONDS=3600
MUSIC_ASSET_URL_MAX_TTL_SECONDS=86400

# Required in addition to HTTP Basic auth for real publication calls with
# dryRun=false. Clients must send the same value in x-music-api-token.
MUSIC_API_EXECUTION_TOKEN=

# EspoCRM is the source of truth for contact data.
ESPOCRM_BASE_URL=
ESPOCRM_API_KEY=
ESPOCRM_TIMEOUT_MS=10000
ESPOCRM_MAX_RESPONSE_BYTES=1000000

# Existing marcsmusic.nl player/download integration.
MARCSMUSIC_SITE_BASE_URL=https://www.marcsmusic.nl
MARCSMUSIC_DOWNLOAD_BASE_URL=/assets/audio
MARCSMUSIC_ARTWORK_BASE_URL=/assets/artwork
MARCSMUSIC_PLAYER_MANIFEST_PATH=./data/player-manifest.json

# Optional official upload API credentials. Leave empty until the provider app
# has been created and OAuth/token storage is in place.
SOUNDCLOUD_ACCESS_TOKEN=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=
SOUNDCLOUD_REFRESH_TOKEN=

AUDIUS_API_KEY=
AUDIUS_BEARER_TOKEN=

MIXCLOUD_ACCESS_TOKEN=

SPREAKER_ACCESS_TOKEN=
SPREAKER_SHOW_ID=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
